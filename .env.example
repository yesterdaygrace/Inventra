# Copy to .env and adjust. NEVER commit real values.
# Required by the API (fails fast when missing):
JWT_SECRET=change-me-strong-random-value
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=inventory

# Host port overrides (defaults: api 8080, db 5432).
# Use API_PORT=8081 DB_PORT=5434 if :8080/:5432 are already taken.
API_PORT=8080
DB_PORT=5432

# Optional API tuning:
# APP_ENV=development
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=168h
# BCRYPT_COST=12
# LOG_LEVEL=info
# DEMO_MODE=true   # expose POST /api/v1/auth/demo (demo auto-login, no password). Dev/demo only!
# Rate limits for public auth routes (requests/minute per IP):
# LOGIN_RATE_LIMIT_RPM=10
# REFRESH_RATE_LIMIT_RPM=30
# REGISTER_RATE_LIMIT_RPM=5
# DEMO_RATE_LIMIT_RPM=5

# DB_AUTOMIGRATE: default true (dev). Set to false in production;
# production schema is managed by `make migrate-up` (golang-migrate).
# DB_AUTOMIGRATE=true
